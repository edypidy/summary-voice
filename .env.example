# Copy to .env and fill in. .env is gitignored — never commit real values.

# Anthropic API — 살리언스 판정, 내레이션 생성, STT 레이어 2 교정
ANTHROPIC_API_KEY=sk-ant-...

# Telegram — @BotFather 에서 /newbot 으로 봇 생성 후 토큰 발급
TELEGRAM_BOT_TOKEN=123456789:AA...
# 봇과 대화를 시작한 뒤 https://api.telegram.org/bot<TOKEN>/getUpdates 로 확인
TELEGRAM_CHAT_ID=123456789
