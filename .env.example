# Copy to .env and fill in. .env is gitignored — never commit real values.

# Anthropic API - 살리언스 판정, 요약 생성
ANTHROPIC_API_KEY=sk-ant-...

# Telegram — @BotFather 에서 /newbot 으로 봇 생성 후 토큰 발급
TELEGRAM_BOT_TOKEN=123456789:AA...
# 봇과 대화를 시작한 뒤 `sv-send --whoami` 로 확인
# 아래 자리표시자를 그대로 두면 require_env 가 '설정 안 됨'으로 거절한다.
# (값 뒤에 인라인 주석을 붙이지 말 것 - 파서가 주석을 떼지 않아 비교가 깨진다)
TELEGRAM_CHAT_ID=123456789
